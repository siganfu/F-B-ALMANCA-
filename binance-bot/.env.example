# Bu dosyayı .env adıyla kopyalayın ve doldurun. .env ASLA git'e eklenmez.

# Binance USDⓈ-M Futures API anahtarı
# - "Enable Withdrawals" (çekim) yetkisi KAPALI olmalı
# - Yalnızca "Enable Futures" açık olsun
# - IP kısıtlaması koyun (evinizin / VPS'inizin IP'si)
# demo modu için Binance Demo Trading'den alınan anahtarı, gercek mod için gerçek anahtarı yazın.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram (isteğe bağlı) — config.yaml'da telegram.aktif: true yapın
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
